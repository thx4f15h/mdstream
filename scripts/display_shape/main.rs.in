#![allow(dead_code, unexpected_cfgs)]
#[path="@SEG_SRC@/tables.rs"] mod segtables;
#[path="@WIDTH_SRC@/lookup.rs"] mod lookup;
#[path="@WIDTH_SRC@/props.rs"] mod props;
#[path="@WIDTH_SRC@/gen/tables.rs"] mod tables;
mod width_info;
#[path="@GCB@"] mod gcb;
use std::{collections::BTreeMap,fmt::Write};
fn main() {
    let mut alphabet=Vec::new();
    for c in (0..=0x10ffff).filter_map(char::from_u32) { let p=gcb::Prop::of(c); if !alphabet.contains(&p) {alphabet.push(p);} }
    let mut states=vec![gcb::State::START];
    let mut at=0;
    while at<states.len() {for &p in &alphabet {let n=states[at].step(p).0;if !states.contains(&n) {states.push(n);}} at+=1;}
    assert_eq!((states.len(),alphabet.len()),(24,18));
    let ws:Vec<u16>=vec!@WIDTH_STATES@;
    let mut state_map=vec![usize::MAX;65536];
    for (i,&s) in ws.iter().enumerate(){state_map[s as usize]=i;}
    let mut classes=BTreeMap::<Vec<u16>,usize>::new();
    let mut width_maps=Vec::new();
    let mut ranges=Vec::<(u32,u32,u8,u16)>::new();
    for c in (0..=0x10ffff).filter_map(char::from_u32) {
        let g=alphabet.iter().position(|&p|p==gcb::Prop::of(c)).unwrap() as u8;
        let sig:Vec<_>=ws.iter().map(|&s|{let(d,n)=lookup::width_in_str(c,width_info::WidthInfo::from_code(s)); let i=state_map[n.code() as usize];assert!(i<132);(i as u16)|(((i16::from(d)+8) as u16)<<8)}).collect();
        let next=classes.len();
        let w=*classes.entry(sig.clone()).or_insert_with(||{width_maps.push(sig);next}) as u16;
        if let Some(last)=ranges.last_mut() {if last.1+1==c as u32 && last.2==g && last.3==w {last.1=c as u32;continue;}}
        ranges.push((c as u32,c as u32,g,w));
    }
    let mut out=String::from("// Generated by scripts/generate_display_shape.py; do not edit.\n// GCB: unicode-segmentation 1.13.3 / Unicode 17.0.0.\n// Width: unicode-width 0.2.3 / Unicode 18.0.0, non-CJK.\n// See data/unicode/display-shape-provenance.json and data/unicode/README.md.\n");
    writeln!(out,"pub(super) static GCB: [[u8; 18]; 24] = [").unwrap();
    for &s in &states {out.push_str("    [");for &p in &alphabet {let(n,b)=s.step(p);let i=states.iter().position(|&x|x==n).unwrap();write!(out,"{},",i+if b {128}else{0}).unwrap();}out.push_str("],\n");}out.push_str("];\n");
    writeln!(out,"pub(super) static WIDTH: [[u16; 132]; {}] = [",width_maps.len()).unwrap();
    for sig in width_maps {writeln!(out,"    {sig:?},").unwrap();}out.push_str("];\n");
    out.push_str("pub(super) static PROPS: &[(u32, u32, u8, u16)] = &[\n");
    for r in &ranges {writeln!(out,"    {r:?},").unwrap();}out.push_str("];\n");
    print!("{out}");
    eprintln!("states=24/132 gcb_classes=18 width_classes={} ranges={} scalar_transitions=146792448",classes.len(),ranges.len());
}
